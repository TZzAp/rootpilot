<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the loopback control page (rootpilot serve) running as mobile, so the home-screen
     icon always works. Install: sudo cp to /Library/LaunchDaemons, chown root:wheel, chmod 644,
     sudo launchctl load. Paths assume the checkout is in /var/mobile/rootpilot. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.rootpilot.serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string><string>-m</string><string>agent</string><string>serve</string>
  </array>
  <key>WorkingDirectory</key><string>/var/mobile/rootpilot</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key><string>/var/mobile/rootpilot</string>
    <key>HOME</key><string>/var/mobile</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>UserName</key><string>mobile</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/var/mobile/.local/state/rootpilot/serve.log</string>
  <key>StandardErrorPath</key><string>/var/mobile/.local/state/rootpilot/serve.log</string>
</dict>
</plist>
